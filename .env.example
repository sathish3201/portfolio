# Copy to .env before running `npm run dev` or `npm run build`. Not
# required — every consumer of VITE_API_BASE falls back to the deployed
# nexoria-backend URL if this isn't set.
#
# Override only if you're pointing this site at a different backend
# (e.g. testing against a local nexoria-backend instance).
VITE_API_BASE=http://localhost:5000/api
