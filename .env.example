# Copy to .env and fill in your own values before running `npm run dev`
# or `npm run build`.
#
# IMPORTANT: this is a static site with no backend. Vite bakes these
# values directly into the public JS bundle at build time — anyone who
# opens browser dev tools can see them. Only use a key/URL you're
# comfortable being publicly visible while your local model + ngrok
# tunnel are running. See ollama-service/README.md for the full tradeoffs.

VITE_LOCAL_MODEL_URL=https://your-static-domain.ngrok-free.dev
VITE_LOCAL_MODEL_API_KEY=sk-local-your-generated-key
VITE_LOCAL_MODEL_NAME=gemma3:1b
